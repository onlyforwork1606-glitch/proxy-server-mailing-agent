# Port for the proxy server to run on
PORT=3000

# Zoho ZeptoMail Send Mail API key (or Send Mail Token)
# Format: Zoho-enczapikey <your_token>
# But you should just store the raw key/token here; the server will prepend Zoho-enczapikey if not present
ZEPTO_API_KEY=your_zepto_api_key_here

# Allowed Origin for CORS (e.g. the Mail Magic frontend app)
ALLOWED_ORIGIN=https://your-mailmagic-app.com

# Baseline stats to seed the dashboard (useful if you only configured webhooks recently)
SEED_TOTAL=25637
SEED_DELIVERED=25455
SEED_OPENS=26275
SEED_CLICKS=2781
SEED_SOFT_BOUNCES=5
SEED_HARD_BOUNCES=165
SEED_FEEDBACK_LOOPS=0

